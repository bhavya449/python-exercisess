import math

print("SCIENTIFIC CALCULATOR")
print("1. Addition")
print("2. Subtraction")
print("3. Multiplication")
print("4. Division")
print("5. Power")
print("6. Square Root")
print("7. Modulo: ")
print("8. Quadratic Equation: ")


choice = int(input("\nEnter your choice (1-7): "))

match choice:

    case 1:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
        print("Result =", a + b)

    case 2:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
        print("Result =", a - b)

    case 3:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
        print("Result =", a * b)

    case 4:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
        if b != 0:
            print("Result =", a / b)
        else:
            print("Error: Cannot divide by zero.")

    case 5:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
        print("Result =", a ** b)

    case 6:
        a = float(input("Enter first number: "))
        if a >= 0:
            print("Square Root =", math.sqrt(a))
        else:
            print("Error: Cannot find square root of a negative number.")

    case 7:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
        print("Result =" , a % b )


    case 8:
        print("Quadratic Equation: ax² + bx + c = 0")

        a = float(input("Enter a: "))
        b = float(input("Enter b: "))
        c = float(input("Enter c: "))

        D = (b ** 2) - 4 * a * c

        print("Discriminant =", D)

        if D > 0:
            x1 = (-b + math.sqrt(D)) / (2 * a)
            x2 = (-b - math.sqrt(D)) / (2 * a)

            print("x1 =", round(x1, 2))
            print("x2 =", round(x2, 2))

        elif D == 0:
            x = -b / (2 * a)
            print("Repeated root =", round(x, 2))

        else:
            print("No real roots.")